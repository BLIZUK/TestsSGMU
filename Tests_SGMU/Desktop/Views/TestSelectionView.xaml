<UserControl x:Class="Tests_SGMU.Desktop.Views.TestSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Выбор теста" 
                   Style="{StaticResource TitleText}"
                   Grid.Row="0"/>

        <!-- Список тестов -->
        <ListView ItemsSource="{Binding AvailableTests}"
                  SelectedItem="{Binding SelectedTest}"
                  Grid.Row="1"
                  Background="{StaticResource SurfaceBrush}"
                  BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,20">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="10"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Questions.Count, StringFormat='Вопросов: {0}'}"
                                   FontSize="12"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding FilePath}"
                                   FontSize="10"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Grid.Row="2" Cursor="Hand">
            <Button Content="📁 Выбрать файл..." 
                    Style="{StaticResource ModernButton}"
                    Command="{Binding SelectFileCommand}"
                    Width="150" Cursor="Hand"/>

            <Button Content="Начать тест" 
                    Style="{StaticResource ModernButton}"
                    Command="{Binding StartTestCommand}"
                    Width="120"
                    Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>