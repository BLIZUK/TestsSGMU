<UserControl x:Class="Tests_SGMU.Desktop.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        
        <TextBlock Text="Тесты по физиологии" 
                   FontSize="28" 
                   Foreground="White" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,40"/>

        <Button Content="📚 Выбор теста" 
                Style="{StaticResource ModernButton}"
                Command="{Binding NavigateToTestSelectionCommand}"
                Width="250"/>

        <Button Content="📖 Все вопросы" 
                Style="{StaticResource ModernButton}"
                Command="{Binding NavigateToAllQuestionsCommand}"
                Width="250"/>

        <Button Content="🎯 Экзамен" 
                Style="{StaticResource ModernButton}"
                Command="{Binding NavigateToExamCommand}"
                Width="250"/>
    </StackPanel>
</UserControl>