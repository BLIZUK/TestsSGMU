<UserControl x:Class="Tests_SGMU.Desktop.Views.AllQuestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название теста -->
        <TextBlock Text="{Binding TestTitle}" 
                   Style="{StaticResource TitleText}"
                   Grid.Row="0"
                   FontSize="24"
                   Margin="0,0,0,10"/>

        <!-- Прогресс -->
        <TextBlock Text="{Binding ProgressText}"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   Foreground="#AAAAAA"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <!-- Вопрос -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">
            <TextBlock Text="{Binding CurrentQuestion.Text}"
                       TextWrapping="Wrap"
                       FontSize="18"
                       Foreground="{StaticResource TextBrush}"
                       TextAlignment="Center"/>
        </Border>

        <!-- Варианты ответов - LISTBOX РЕШЕНИЕ -->
        <ListBox ItemsSource="{Binding CurrentQuestion.Options}"
         SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}"
         Grid.Row="3"
         Margin="0,0,0,20"
         Background="Transparent"
         BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <RadioButton Content="{Binding}"
                                     GroupName="Answers"
                                     Margin="10,5"
                                     FontSize="14"
                                     Foreground="{StaticResource TextBrush}"
                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Результат проверки -->
        <Border Grid.Row="4"
                Background="{Binding ResultColor}"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,20"
                Visibility="{Binding IsAnswerConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ResultMessage}"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Кнопки навигации -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Grid.Row="5">
            <Button Content="⬅ Назад"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding BackCommand}"
                    Width="100"/>

            <Button Content="⬅ Предыдущий"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding PreviousCommand}"
                    Width="120"
                    Margin="20,0,0,0"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="Подтвердить"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding ConfirmCommand}"
                    Width="120"
                    Margin="20,0,0,0"
                    Visibility="{Binding IsAnswerConfirmed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <Button Content="Далее ➡"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding NextCommand}"
                    Width="120"
                    Margin="20,0,0,0"
                    Visibility="{Binding CanGoForward, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>