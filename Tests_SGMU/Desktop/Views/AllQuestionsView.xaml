<UserControl x:Class="Tests_SGMU.Desktop.Views.AllQuestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название теста -->
        <TextBlock Text="{Binding TestTitle}" 
                   Style="{StaticResource TitleText}"
                   Grid.Row="0"
                   FontSize="24"
                   Margin="0,0,0,10"/>

        <!-- Прогресс -->
        <TextBlock Text="{Binding ProgressText}"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   Foreground="#AAAAAA"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <!-- Вопрос -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">
            <TextBlock Text="{Binding CurrentQuestion.Text}"
                       TextWrapping="Wrap"
                       FontSize="18"
                       Foreground="{StaticResource TextBrush}"
                       TextAlignment="Center"/>
        </Border>

        <!-- Варианты ответов -->
        <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}"
              Grid.Row="3"
              Margin="0,0,0,20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding}"
                         GroupName="Answers"
                         Margin="5,10"
                         FontSize="14"
                         Foreground="{StaticResource TextBrush}"
                         IsChecked="{Binding Path=DataContext.SelectedAnswer, 
                                            RelativeSource={RelativeSource AncestorType=UserControl}, 
                                            Mode=TwoWay,
                                            Converter={StaticResource RadioButtonConverter},
                                            ConverterParameter={Binding}}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="radioBorder"
                                                Grid.Column="0"
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,10,0"
                                                BorderThickness="2"
                                                BorderBrush="#007ACC"
                                                CornerRadius="10">
                                                    <Ellipse x:Name="radioFill"
                                                     Fill="Transparent"
                                                     Margin="3"/>
                                                </Border>

                                                <ContentPresenter Grid.Column="1"
                                                          VerticalAlignment="Center"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="radioFill" Property="Fill" Value="#007ACC"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="radioBorder" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Результат проверки -->
        <Border Grid.Row="4"
                Background="{Binding ResultColor}"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,20"
                Visibility="{Binding IsAnswerConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ResultMessage}"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Кнопки навигации -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Grid.Row="5">
            <Button Content="⬅ Назад"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding BackCommand}"
                    Width="100"/>

            <Button Content="⬅ Предыдущий"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding PreviousCommand}"
                    Width="120"
                    Margin="20,0,0,0"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="Подтвердить"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding ConfirmCommand}"
                    Width="120"
                    Margin="20,0,0,0"
                    Visibility="{Binding IsAnswerConfirmed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <Button Content="Далее ➡"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding NextCommand}"
                    Width="120"
                    Margin="20,0,0,0"
                    Visibility="{Binding CanGoForward, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>